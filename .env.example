# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://weblogic.digital
NEXT_PUBLIC_CONTACT_EMAIL=support@weblogic.digital
SUPPORT_EMAIL=support@weblogic.digital

# ─── Lead form / Resend ──────────────────────────────────────────────────────
# https://resend.com → API Keys. Verify weblogic.digital as a sending domain
# (add SPF / DKIM / DMARC records from Resend → Domains in your DNS).
RESEND_API_KEY=
LEAD_FROM_EMAIL="WebLogic Support <support@weblogic.digital>"
LEAD_TO_EMAIL=caleb@weblogic.digital
# Optional generic webhook for HubSpot / Slack / Zapier / Make.com
LEAD_WEBHOOK_URL=

# ─── Admin gate ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── Stripe — secret + publishable ───────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

