# ─── Email delivery ───────────────────────────────────────────────────────────
# To make the "Talk to an Expert" form actually email you, sign up at
# https://resend.com (free tier — 3,000 emails/month, no credit card),
# verify a domain (or use the onboarding@resend.dev sender for testing),
# generate an API key, and paste it below.
RESEND_API_KEY=
# Where leads are delivered to:
LEAD_TO_EMAIL=studio@weblogic.studio
# (Optional) Override the From address — must be a verified Resend domain:
LEAD_FROM_EMAIL=WebLogic <studio@weblogic.studio>

# ─── Optional generic webhook (HubSpot / Salesforce / Slack / Make.com) ──────
LEAD_WEBHOOK_URL=

# ─── CMS swap (kept for future) ──────────────────────────────────────────────
STORYBLOK_PREVIEW_TOKEN=
SANITY_API_TOKEN=

# ─── Admin gate ──────────────────────────────────────────────────────────────
# Credentials for /admin. Read by the server action `loginAction()` — never
# exposed to the client bundle. If unset, falls back to the dev defaults
# weblogic / admin2026 so first-clone works. ALWAYS override in production.
ADMIN_USERNAME=weblogic
ADMIN_PASSWORD=admin2026

# ─── Stripe (checkout) ───────────────────────────────────────────────────────
# Sign up at https://dashboard.stripe.com, then grab the secret key from
# Developers → API keys. Use the `sk_test_…` key for development.
# If this is unset, /checkout runs in "simulated" mode — the form still
# submits, but routes straight to /thank-you with the totals in the URL.
STRIPE_SECRET_KEY=
# (Optional, only if you also want client-side Stripe.js for embedded UIs.)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
